generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// 1. QUẢN TRỊ VIÊN
// -----------------------------------------
model Admin {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  username String @unique
  password String
  name     String
}

// -----------------------------------------
// 2. TIN TỨC
// -----------------------------------------
model Post {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique // Slug SEO-friendly
  thumbnail String   // Ảnh đại diện (đường dẫn)
  date      DateTime // Ngày đăng
  category  String   // Loại tin tức
  title     String   // Tiêu đề
  content   String   // Tin chi tiết
  createdAt DateTime @default(now())
}

// -----------------------------------------
// 5. THƯ VIỆN (ảnh hoặc video)
// -----------------------------------------
model Library {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  type         LibraryType // IMAGE hoặc VIDEO
  imageUrl     String?     // Đường dẫn ảnh (khi type = IMAGE)
  videoUrl     String?     // Đường dẫn video (khi type = VIDEO)
  thumbnailUrl String?     // Ảnh thu nhỏ (thumbnail)
  date         DateTime    // Ngày
  title     String      // Tiêu đề
  createdAt DateTime    @default(now())
}

enum LibraryType {
  IMAGE
  VIDEO
}

// -----------------------------------------
// 6. LIÊN HỆ
// -----------------------------------------
model Contact {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName   String   // Họ tên
  email      String   // Email
  phone      String   // Số điện thoại
  message    String   // Nội dung tin nhắn
  isResolved Boolean  @default(false) // true = đã xử lý
  createdAt  DateTime @default(now())
}