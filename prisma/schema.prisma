generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// 1. QUẢN LÝ BÀI VIẾT (Tin tức, Thông báo, Tuyển dụng)
// -----------------------------------------
model Post {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique // Ví dụ: "le-hoi-trang-ram-2026"
  content     String    // Nội dung dạng HTML từ trình soạn thảo
  thumbnail   String    // Link ảnh đại diện bài viết
  category    Category  @default(TIN_TUC)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category, createdAt]) // Tối ưu tìm kiếm tin theo danh mục và ngày
}

enum Category {
  GIOI_THIEU
  TIN_TUC
  THONG_BAO
  HOAT_DONG
  TUYEN_DUNG
}

// -----------------------------------------
// 2. QUẢN LÝ LIÊN HỆ (Từ form Phụ huynh - Hình 5)
// -----------------------------------------
model Contact {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  parentName  String
  phone       String
  email       String?
  message     String
  status      ContactStatus @default(PENDING)
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

enum ContactStatus {
  PENDING   // Chờ xử lý
  CONTACTED // Đã liên hệ lại
  CANCELLED // Hủy bỏ
}

// -----------------------------------------
// 3. QUẢN LÝ THỜI GIAN BIỂU (Hình 1)
// -----------------------------------------
model Schedule {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ageGroup    String   // Ví dụ: "Lớp Mầm (2-3 tuổi)"
  activities  Activity[] // Danh sách các hoạt động trong ngày
  updatedAt   DateTime @updatedAt
}

// Kiểu dữ liệu nhúng (Embedded Type) - Đặc sản của MongoDB
type Activity {
  time    String // "07:30 - 08:30"
  content String // "Đón trẻ và ăn sáng"
}

// -----------------------------------------
// 4. QUẢN LÝ THỰC ĐƠN (Menu hàng tuần)
// -----------------------------------------
model WeeklyMenu {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  weekStart DateTime // Ngày đầu tuần (Thứ 2)
  days      DailyMenu[]
}

type DailyMenu {
  dayOfWeek String   // "Thứ Hai", "Thứ Ba"...
  breakfast String
  lunch     String
  snack     String   // Bữa xế
}

// -----------------------------------------
// 5. QUẢN TRỊ VIÊN (Admin)
// -----------------------------------------
model Admin {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  username String  @unique
  password String  // Sẽ được mã hóa Bcrypt
  name     String
  role     AdminRole @default(STAFF)
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
}