generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// 1. QUẢN TRỊ VIÊN (Để bạn đăng nhập vào Admin Panel)
// -----------------------------------------
model Admin {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  username String  @unique
  password String
  name     String
  role     String  @default("ADMIN")
}

// -----------------------------------------
// 2. SLIDER HERO (Hình 1: KinderFit, v.v...)
// -----------------------------------------
model HeroSlider {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  image       String   // URL ảnh nền
  title       String   // "KinderFit Programme..."
  description String   // "KinderFit provides 50% more..."
  order       Int      @default(0) // Thứ tự hiển thị
  isActive    Boolean  @default(true)
}

// -----------------------------------------
// 3. PHƯƠNG PHÁP DẠY HỌC (Hình 2: FasTrackKids, Montessori...)
// -----------------------------------------
model TeachingMethod {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   // "Montessori"
  icon        String   // URL ảnh/icon đại diện
  tagline     String   // "Chiếc nôi ươm mầm..."
  description String?  // Mô tả chi tiết khi bấm vào (nếu có)
  order       Int      @default(0)
}

// -----------------------------------------
// 4. HOẠT ĐỘNG & THỜI GIAN BIỂU (Hình 3: 2-3 tuổi, 3-4 tuổi...)
// -----------------------------------------
model AgeGroupSchedule {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  ageRange      String   @unique // "2-3 tuổi", "3-4 tuổi"
  coverImage    String   // Ảnh hai bé đeo nơ trong hình
  
  // Danh sách các mục Hoạt động (Cột bên trái)
  activities    String[] // ["Lễ giáo", "Nhận biết tập nói", ...]

  // Danh sách Thời gian biểu (Cột bên phải)
  timetable     TimeSlot[]
}

type TimeSlot {
  time    String // "6h30-8h15"
  content String // "Đón trẻ, thể dục, tắm nắng"
}

// -----------------------------------------
// 5. CƠ SỞ VẬT CHẤT (Hình 4: Ngôi trường đẹp, trang thiết bị...)
// -----------------------------------------
model Infrastructure {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String   // "Hệ thống trang thiết bị..."
  description String   // "Nằm trong quy hoạch..."
  images      String[] // Mảng chứa các URL ảnh slider cơ sở vật chất
  icon        String?  // Icon minh họa bên cạnh tiêu đề
  order       Int      @default(0)
}

// -----------------------------------------
// 6. TIN TỨC & CHIA SẺ PHỤ HUYNH (Hình 5, 6)
// -----------------------------------------
model Post {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  summary     String?   // Đoạn văn ngắn giới thiệu bên dưới ảnh
  content     String    // Nội dung chi tiết
  thumbnail   String    // Ảnh đại diện
  category    PostType  @default(NEWS)
  createdAt   DateTime  @default(now())
}

enum PostType {
  NEWS        // Tin tức - Sự kiện
  TESTIMONIAL // Chia sẻ phụ huynh (Hình 6)
}

// -----------------------------------------
// 7. FORM ĐĂNG KÝ TƯ VẤN (Hình 7 - Rất chi tiết)
// -----------------------------------------
model Contact {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  parentName    String
  email         String
  phone         String
  campus        String   // "Chọn cơ sở quan tâm"
  targetClass   String   // "Koala 18-36 tháng", "Panda 3 tuổi"...
  message       String?  // "Nội dung"
  status        String   @default("PENDING") // PENDING, CONTACTED
  createdAt     DateTime @default(now())
}