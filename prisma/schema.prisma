generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// 1. QUẢN TRỊ VIÊN
// -----------------------------------------
model Admin {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  username String @unique
  password String
  name     String
}

// -----------------------------------------
// 2. GIỚI THIỆU
// -----------------------------------------
model Introduction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  image     String   // Đường dẫn ảnh
  text      String   // Nội dung giới thiệu
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// -----------------------------------------
// 3. CHƯƠNG TRÌNH HỌC
// -----------------------------------------
model Curriculum {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  image     String   // Đường dẫn ảnh
  text      String   // Mô tả chương trình học
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// -----------------------------------------
// 4. TIN TỨC
// -----------------------------------------
model Post {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  image     String   // Đường dẫn ảnh
  text      String   // Nội dung tin tức
  createdAt DateTime @default(now())
}

// -----------------------------------------
// 5. THƯ VIỆN (ảnh hoặc video)
// -----------------------------------------
model Library {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  type      LibraryType // IMAGE hoặc VIDEO
  mediaUrl  String      // Đường dẫn ảnh hoặc link YouTube
  text      String      // Mô tả
  createdAt DateTime    @default(now())
}

enum LibraryType {
  IMAGE
  VIDEO
}

// -----------------------------------------
// 6. LIÊN HỆ
// -----------------------------------------
model Contact {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName   String   // Họ tên
  email      String   // Email
  phone      String   // Số điện thoại
  message    String   // Nội dung tin nhắn
  isResolved Boolean  @default(false) // true = đã xử lý
  createdAt  DateTime @default(now())
}